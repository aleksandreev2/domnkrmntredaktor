{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domnkrmntredaktor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domnkrmntredaktor-db",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["TELEGRAM_CLIENT_SECRET"]
  },
  "vars": {
    "TELEGRAM_BOT_USERNAME": "domnekromanta_bot",
    "TELEGRAM_CLIENT_ID": "8679009127"
  }
}
